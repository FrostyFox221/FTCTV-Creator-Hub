    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.9.0",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^10.0.13",
    "pino": "^9",
    "pino-http": "^10",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.27.3",
